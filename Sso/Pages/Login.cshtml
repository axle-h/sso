@page
@model Sso.Pages.Index

@{
    Layout = "_LayoutHero";
}

<h1 class="hero-title">
    <b>Hi!</b> Sign in to your ax-h account.
</h1>

<partial name="_ValidationSummary" />

<form method="post" class="busy-on-submit">
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="form-floating mb-3">
        <input asp-for="Username"
               class="form-control"
               placeholder="Username"
               autocomplete="username"
               autocapitalize="none"
               autocorrect="off"
               spellcheck="false"
               autofocus
               required />
        <label asp-for="Username">Username</label>
    </div>

    <div class="input-group password-input mb-3">
        <div class="form-floating">
            <input asp-for="Password"
                   type="password"
                   class="form-control"
                   placeholder="Password"
                   autocomplete="current-password"
                   required />
            <label asp-for="Password">Password</label>
        </div>
        <button class="btn btn-outline-secondary password-toggle" type="button" aria-label="Show password">
            <partial name="Icons/Eye" />
            <partial name="Icons/EyeSlash" />
        </button>
    </div>

    <div class="form-check mb-4">
        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
        <label asp-for="RememberMe" class="form-check-label">Keep me signed in</label>
    </div>

    <div class="pt-1 mb-4">
        <button class="btn btn-outline-primary btn-lg submit-button" type="submit">
            <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
            Login
        </button>
    </div>
</form>
