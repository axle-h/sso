@page
@model Sso.Pages.ChangePassword

@{
    Layout = "_LayoutHero";
}

<h1 class="hero-title">
    Change your password.
</h1>

<partial name="_ValidationSummary" />

<form method="post" class="busy-on-submit">
    <div class="input-group password-input mb-3">
        <div class="form-floating">
            <input asp-for="NewPassword"
                   type="password"
                   class="form-control"
                   placeholder="New Password"
                   autocomplete="new-password"
                   autofocus
                   required />
            <label asp-for="NewPassword">New Password</label>
        </div>
        <button class="btn btn-outline-secondary password-toggle" type="button" aria-label="Show password">
            <partial name="Icons/Eye" />
            <partial name="Icons/EyeSlash" />
        </button>
    </div>

    <div class="form-floating mb-4">
        <input asp-for="ConfirmPassword"
               type="password"
               class="form-control"
               placeholder="Confirm Password"
               autocomplete="new-password"
               required />
        <label asp-for="ConfirmPassword">Confirm Password</label>
    </div>

    <div class="pt-1 mb-4">
        <button class="btn btn-outline-primary btn-lg submit-button" type="submit">
            <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
            Submit
        </button>
    </div>
</form>
