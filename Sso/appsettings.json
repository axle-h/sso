{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.AspNetCore.Http.ResponseCookies": "Error"
      }
    },
    "Using": ["Serilog.Sinks.Console"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Db": "Data Source=sso.db"
  },
  "Migration": {
    "Migrate": true
  },
  "Clients": {
    "make-money": {
      "Name": "Make Money",
      "Origins": ["https://money.ax-h.com"],
      "Scopes": ["openid", "profile", "email", "roles"]
    },
    "make-movies": {
      "Name": "Make Movies",
      "Origins": ["https://movies.ax-h.com"],
      "Scopes": ["openid", "profile", "email", "roles"]
    },
    "risk": {
      "Name": "Risk With Friends",
      "Origins": ["https://risk.ax-h.com"],
      "Scopes": ["openid", "profile", "email", "roles", "read_users"]
    }
  },
  "Users": [
    {
      "Username": "alex",
      "Email": "alex.haslehurst@gmail.com",
      "FirstName": "Alex",
      "LastName": "Haslehurst",
      "Roles": ["make-money", "make-movies", "risk", "admin"]
    }
  ]
}
